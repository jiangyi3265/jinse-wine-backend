MINI_WECHAT_LOTTERY_LINK_PREFIX=https://jiuyekl.oksja.cn/qr/lottery/
MINI_WECHAT_PAY_NOTIFY_URL=https://jiuyekl.oksja.cn/wechat/pay/notify
MINI_WECHAT_REFUND_NOTIFY_URL=https://jiuyekl.oksja.cn/wechat/pay/refund-notify
MINI_WECHAT_TRANSFER_NOTIFY_URL=https://jiuyekl.oksja.cn/wechat/pay/transfer-notify
MINI_WECHAT_CODE_ENV_VERSION=release
MINI_WECHAT_CODE_CHECK_PATH=true
MINIO_ENABLED=true
PUBLIC_MEDIA_BASE_URL=https://jiuyekl.oksja.cn
MINIO_ENDPOINT=https://minio.example.com
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=jinse-wine
MINIO_SEED_LOCAL_FILES=false
# Tencent Location WebService: required for creating stores or changing their addresses.
TENCENT_MAP_KEY=
# Optional: fill only if SK request signing is enabled for the Key.
TENCENT_MAP_SK=

# WeChat Pay v3. Keep the key files outside the repository on the server.
# MINI_WECHAT_PRIVATE_KEY and MINI_WECHAT_PLATFORM_CERT may be absolute PEM paths.
MINI_WECHAT_PAY_ENABLED=false
MINI_WECHAT_MERCHANT_ID=
MINI_WECHAT_MERCHANT_SERIAL=
MINI_WECHAT_PRIVATE_KEY=/replace/on/server/wechat-pay/apiclient_key.pem
MINI_WECHAT_API_V3_KEY=
MINI_WECHAT_PLATFORM_CERT=/replace/on/server/wechat-pay/pub_key.pem
MINI_WECHAT_PLATFORM_SERIAL=
# Enable only after merchant transfer is opened and a transfer scene is approved.
MINI_WECHAT_TRANSFER_ENABLED=false
MINI_WECHAT_TRANSFER_SCENE_ID=
